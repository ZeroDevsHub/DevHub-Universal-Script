local ServerSection = MainTab:CreateSection("Server")
ServerSection:CreateButton({
    Name = "Rejoin",
    Callback = function()
        printMsg("Rejoining...")
        pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer) end)
    end,
})
ServerSection:CreateButton({
    Name = "Server Hop",
    Callback = function()
        printMsg("Finding fullest server...")
        local placeId = game.PlaceId
        local exclude = game.JobId
        task.spawn(function()
            local ok, res = pcall(function() return game:HttpGet("https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Desc&limit=100") end)
            local data
            if ok and res then pcall(function() data = HttpService:JSONDecode(res) end) end
            local pool = {}
            if data and data.data then
                for _, s in ipairs(data.data) do
                    if s.id ~= exclude and (s.playing or 0) < (s.maxPlayers or 99) then
                        table.insert(pool, s)
                    end
                end
            end
            if #pool > 0 then
                table.sort(pool, function(a,b) return (a.playing or 0) > (b.playing or 0) end)
                pcall(function() TeleportService:TeleportToPlaceInstance(placeId, pool[1].id, LocalPlayer) end)
            else
                printMsg("No open servers found")
            end
        end)
    end,
})
ServerSection:CreateButton({
    Name = "Join MM2",
    Callback = function()
        printMsg("Joining Murder Mystery 2...")
        local MM2_PLACE = 142823291
        task.spawn(function()
            local ok, res = pcall(function() return game:HttpGet("https://games.roblox.com/v1/games/" .. MM2_PLACE .. "/servers/Public?sortOrder=Desc&limit=100") end)
            local data
            if ok and res then pcall(function() data = HttpService:JSONDecode(res) end) end
            local pool = {}
            if data and data.data then
                for _, s in ipairs(data.data) do
                    if (s.playing or 0) < (s.maxPlayers or 99) then
                        table.insert(pool, s)
                    end
                end
            end
            if #pool > 0 then
                table.sort(pool, function(a,b) return (a.playing or 0) > (b.playing or 0) end)
                pcall(function() TeleportService:TeleportToPlaceInstance(MM2_PLACE, pool[1].id, LocalPlayer) end)
            else
                pcall(function() TeleportService:Teleport(MM2_PLACE, LocalPlayer) end)
            end
        end)
    end,
})

