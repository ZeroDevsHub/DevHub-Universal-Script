CoinSection:CreateButton({
    Name = "Teleport to Nearest Coin",
    Callback = function()
        local hrp = getHRP(LocalPlayer.Character)
        if not hrp then return end
        local best, bd
        for _, c in ipairs(coinCache) do
            if not coinTaken(c) then
                local d = (c.Position - hrp.Position).Magnitude
                if not bd or d < bd then bd, best = d, c end
            end
        end
        if best then
            hrp.CFrame = CFrame.new(best.Position + Vector3.new(0,2,0))
            printMsg("Teleported to coin")
        else
            printMsg("No coins on map")
        end
    end,
})

