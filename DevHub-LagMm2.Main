-- TELEPORT TAB
local TeleportTab = Window:CreateTab("Teleport", 80758916183665)

local TpSection = TeleportTab:CreateSection("Player Teleport")
TpSection:CreateInput({
    Name = "Player Name",
    PlaceholderText = "Type player name...",
    Callback = function(txt)
        -- store for later use
        TpSection._targetName = txt
    end,
})
TpSection:CreateButton({
    Name = "Teleport to Player",
    Callback = function()
        local name = TpSection._targetName
        if not name or name == "" then
            printMsg("Enter a player name first")
            return
        end
        local target
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Name:lower() == name:lower() or (p.DisplayName and p.DisplayName:lower() == name:lower()) then
                target = p
                break
            end
        end
        if not target then
            printMsg("Player not found")
            return
        end
        local ch = target.Character
        local hrp = ch and getHRP(ch)
        if hrp then
            local myhrp = getHRP(LocalPlayer.Character)
            if myhrp then
                myhrp.CFrame = CFrame.new(hrp.Position + Vector3.new(0,3,0))
                printMsg("Teleported to " .. target.Name)
            end
        else
            printMsg("That player is dead or has no character")
        end
    end,
})

local CoinSection = TeleportTab:CreateSection("Coins")
CoinSection:CreateToggle({
    Name = "Auto Collect Coins",
    CurrentValue = flags.autoCoins,
    Flag = "AutoCoins",
